# Optional: enables AI explanations (otherwise deterministic template explanations are used)
# LLM_PROVIDER: "anthropic" (Claude) or "openrouter" (any OpenRouter model that supports tool calling)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
# OpenRouter: free models end in ":free"; pick one listed with "tools" support at openrouter.ai/models
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
